<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/vpn_back_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:src="@drawable/ic_arrow_right"
                android:rotation="180"
                app:tint="@color/text_secondary"
                android:background="?attr/selectableItemBackgroundBorderless" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="🛡️ VPN Traffic Control"
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:letterSpacing="0.15"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/vpn_status_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFF"
                android:textColor="@android:color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:background="@drawable/bg_badge_rounded" />

        </LinearLayout>

        <!-- VPN Toggle Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="20dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="16dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VPN Status"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Intercept and monitor device traffic"
                        android:textColor="@color/text_hint"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />

                </LinearLayout>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/vpn_master_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ── LIVE TRAFFIC section ───────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="LIVE TRAFFIC"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/vpn_clear_traffic_btn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Clear"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/surface_variant"
                android:textColor="@color/text_secondary"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/vpn_traffic_rv"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="400dp"
            android:paddingHorizontal="16dp"
            android:clipToPadding="false"
            android:nestedScrollingEnabled="false" />

        <TextView
            android:id="@+id/vpn_traffic_empty"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:gravity="center"
            android:text="No traffic captured yet"
            android:textColor="@color/text_hint"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- ── BLOCKED APPS section ──────────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BLOCKED APPS"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/vpn_add_app_btn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="Manage Apps"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/vpn_blocked_apps_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            android:id="@+id/vpn_apps_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="8dp"
            android:text="No apps blocked — all app traffic is intercepted"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

        <!-- ── BLOCKED DOMAINS section ───────────────────────────────────── -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginVertical="16dp"
            android:background="@color/divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingBottom="10dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="BLOCKED DOMAINS"
                android:textColor="@color/text_hint"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:fontFamily="sans-serif-medium" />

            <Button
                android:id="@+id/vpn_add_domain_btn"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:text="+ Add Domain"
                android:textSize="11sp"
                android:textAllCaps="false"
                android:backgroundTint="@color/primary"
                android:textColor="@color/on_primary"
                android:paddingHorizontal="12dp" />

        </LinearLayout>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/vpn_blocked_domains_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="16dp"
            android:paddingBottom="4dp"
            app:chipSpacingVertical="6dp" />

        <TextView
            android:id="@+id/vpn_domains_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp"
            android:text="No domains blocked"
            android:textColor="@color/text_hint"
            android:textSize="12sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
