<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="16dp">

        <!-- Date selector and Search -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_variant"
            app:cardCornerRadius="14dp"
            app:cardElevation="4dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="FILTERS &amp; SEARCH"
                        android:textColor="@color/text_hint"
                        android:textSize="10sp"
                        android:letterSpacing="0.15"
                        android:fontFamily="sans-serif-medium" />

                    <Spinner
                        android:id="@+id/system_app_usage_sort_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="24dp"
                        android:background="@null" />
                </LinearLayout>

                <Spinner
                    android:id="@+id/system_app_usage_statistics_fragment_dropdown_spinner"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/spinner_bg"
                    android:paddingHorizontal="12dp"
                    android:popupBackground="@color/surface_variant"
                    android:layout_marginBottom="12dp" />

                <EditText
                    android:id="@+id/system_app_usage_search_input"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@drawable/group_border"
                    android:hint="Search app name..."
                    android:textColorHint="@color/text_hint"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:paddingHorizontal="16dp"
                    android:maxLines="1"
                    android:inputType="text"
                    android:imeOptions="actionSearch" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Dynamic content injected here -->
        <LinearLayout
            android:id="@+id/system_app_usage_statistics_fragment_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="24dp" />

    </LinearLayout>
</ScrollView>
