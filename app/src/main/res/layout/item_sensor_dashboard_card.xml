<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/surface_variant"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/sensor_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_badge_rounded"
                android:backgroundTint="@color/primary_container"
                android:gravity="center"
                android:text="📡"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/sensor_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Accelerometer"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/sensor_category"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Motion Sensor"
                    android:textColor="@color/text_hint"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/sensor_last_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="9.81 m/s²"
                android:textColor="@color/primary"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sensor_graph_container"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingTop="8dp"
            android:paddingBottom="4dp"
            android:background="@color/nav_bg"
            android:clipToPadding="false">
            <!-- Sparkline bars will be added here dynamically -->
        </LinearLayout>

        <TextView
            android:id="@+id/sensor_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Device is currently steady"
            android:textColor="@color/primary"
            android:textSize="13sp"
            android:textStyle="italic" />

        <TextView
            android:id="@+id/sensor_raw_values"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="X: 0.12, Y: 0.45, Z: 9.80"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:fontFamily="monospace" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:background="@color/primary_container"
            android:orientation="horizontal"
            android:clipToOutline="true">

            <View
                android:id="@+id/sensor_variance_bar"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.5"
                android:background="@color/primary" />
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
